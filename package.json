{
  "name": "bezelkit",
  "version": "0.1.0",
  "description": "Zero-dependency web component for device mockups (iPhone, Android, iPad, MacBook, iMac, Watch, browser) that fit screenshots correctly.",
  "homepage": "https://bezelkit.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knileshh/bezelkit.git"
  },
  "bugs": {
    "url": "https://github.com/knileshh/bezelkit/issues"
  },
  "type": "module",
  "main": "./src/bezel.js",
  "module": "./src/bezel.js",
  "exports": {
    ".": "./src/bezel.js",
    "./devices": "./src/devices.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./src/bezel.js"
  ],
  "scripts": {
    "dev": "python -m http.server 8766"
  },
  "keywords": [
    "mockup",
    "device-frame",
    "web-component",
    "iphone",
    "android",
    "ipad",
    "macbook",
    "screenshot",
    "custom-element"
  ],
  "license": "MIT"
}
