{
  "name": "bezelkit",
  "version": "0.1.0",
  "description": "Zero-dependency web component for device mockups (iPhone, Android, iPad, MacBook, iMac, Watch, browser) that fit screenshots correctly.",
  "homepage": "https://bezelkit.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knileshh/bezelkit.git"
  },
  "bugs": {
    "url": "https://github.com/knileshh/bezelkit/issues"
  },
  "type": "module",
  "main": "./src/bezel.js",
  "module": "./src/bezel.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/bezel.js"
    },
    "./devices": "./src/devices.js",
    "./bundle": "./dist/bezelkit.js",
    "./devices.json": "./devices.json"
  },
  "files": [
    "src",
    "dist",
    "index.d.ts",
    "devices.json",
    "llms.txt",
    "llms-full.txt",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./src/bezel.js"
  ],
  "scripts": {
    "dev": "python -m http.server 8766",
    "build": "node scripts/build.mjs && node scripts/gen-docs.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mockup",
    "device-frame",
    "web-component",
    "iphone",
    "android",
    "ipad",
    "macbook",
    "screenshot",
    "custom-element"
  ],
  "license": "MIT",
  "jsdelivr": "./dist/bezelkit.js",
  "unpkg": "./dist/bezelkit.js",
  "types": "./index.d.ts"
}
